# Example Streamlit secrets — copy to secrets.toml and fill in to enable SharePoint
# durable storage. secrets.toml is git-ignored (never commit real credentials).
# On Streamlit Community Cloud, paste these into: app → ⋮ → Settings → Secrets.
# Leave this file out / keys unset to keep using the local brewery_data.xlsx instead.
# See DEPLOYMENT_RUNBOOK.md (Phase 3–4) for how Karben4 IT produces these values.

MS_TENANT_ID      = "your-tenant-id"
MS_CLIENT_ID      = "your-app-client-id"
MS_CLIENT_SECRET  = "your-client-secret-value"
MS_DRIVE_ID       = "the-sharepoint-library-drive-id"
MS_DATA_ITEM_PATH = "brewery_data.xlsx"   # or e.g. "Brewing/brewery_data.xlsx"


# ── Karben4 SSO login (optional) ────────────────────────────────────────────
# Enables the sign-in gate: only Karben4 Microsoft 365 accounts can open the app.
# Leave this whole [auth] section out to keep the app open (no login).
# See DEPLOYMENT_RUNBOOK.md (Phase 3C / Phase 4) for the one-time Entra registration steps.
#
# redirect_uri MUST exactly match a Web redirect URI registered on the Entra app:
#   • local dev : http://localhost:8501/oauth2callback
#   • deployed  : https://<your-app>.streamlit.app/oauth2callback
# cookie_secret: any long random string (e.g. `python -c "import secrets;print(secrets.token_hex(32))"`).
# server_metadata_url: single-tenant → put Karben4's tenant id in the path (limits
#   sign-in to the Karben4 org).

[auth]
redirect_uri        = "http://localhost:8501/oauth2callback"
cookie_secret       = "replace-with-a-long-random-string"
client_id           = "your-entra-app-client-id"
client_secret       = "your-entra-app-client-secret-value"
server_metadata_url = "https://login.microsoftonline.com/your-tenant-id/v2.0/.well-known/openid-configuration"

# Optional domain allow-list (belt-and-suspenders on top of single-tenant).
# Unset → any user the Entra app admits is allowed.
[karben4]
allowed_domains = ["karben4.com"]
